"Self-timer" = "Samospoušť";
"Off" = "Vypnuto";
"%lld s" = "%lld s";
"Cancel self-timer" = "Zrušit samospoušť";
"Cancel the countdown (Esc)" = "Zrušit odpočet (Esc)";
"Self-timer: photos wait for a countdown (S takes one photo with it)" = "Samospoušť: fotky počkají na odpočet (S vyfotí se samospouští jednou)";
"Photo in %lld s" = "Fotka za %lld s";
"Take photo with self-timer" = "Vyfotit se samospouští";
