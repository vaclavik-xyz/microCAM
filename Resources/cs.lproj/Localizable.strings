"Can't save the token in the Keychain, so the MCP server stays off." = "Token nejde uložit do Klíčenky, takže MCP server zůstane vypnutý.";
"The MCP server can't start on port %lld: %@. Try another port." = "MCP server nejde spustit na portu %lld: %@. Zkus jiný port.";
"MCP server for AI agents" = "MCP server pro AI agenty";
"AI agents on other computers on your network can see the camera, take photos and record. You see what they do." = "AI agenti na jiných počítačích v síti uvidí kameru, můžou fotit a nahrávat. Co udělají, uvidíš.";
"Press Return to apply. Agents reconnect by themselves." = "Potvrď Enterem. Agenti se znovu připojí sami.";
"Show" = "Zobrazit";
"Hide" = "Skrýt";
"New token" = "Nový token";
"Agents with the old token lose access until you connect them again." = "Agenti se starým tokenem ztratí přístup, dokud je znovu nepřipojíš.";
"Agents send it with every request." = "Agenti ho posílají s každým požadavkem.";
"Anyone with the token controls the camera. Give it only to your own agents." = "Kdo má token, ovládá kameru. Dej ho jen svým agentům.";
"Connect an agent" = "Připojit agenta";
"Paste the configuration into the MCP settings of the agent's app. The address and the Authorization header work in any MCP client." = "Vlož konfiguraci do nastavení MCP v aplikaci agenta. Adresa a hlavička Authorization fungují v každém MCP klientovi.";
"Copy configuration" = "Kopírovat konfiguraci";
"Copies the MCP client configuration with this address and the token." = "Zkopíruje konfiguraci MCP klienta s touto adresou a tokenem.";
"Tools: status, live picture, photo, recent captures, start and stop recording, and the job." = "Nástroje: stav, živý obraz, fotka, poslední záznamy, spuštění a zastavení nahrávání a zakázka.";

/* Shortcuts actions */
"Choose where to save photos and videos in microCAM first." = "Nejdřív v microCAM vyber, kam ukládat fotky a videa.";
"Jobs are off. Turn them on in Settings → Storage." = "Zakázky jsou vypnuté. Zapni je v Nastavení → Ukládání.";
"New photos and videos go into the job's folder. Leave it empty for no job." = "Nové fotky a videa půjdou do složky zakázky. Nech prázdné pro žádnou zakázku.";
"Set job" = "Nastavit zakázku";
"Set job to ${job}" = "Nastavit zakázku na ${job}";
"Start recording" = "Spustit nahrávání";
"Starts a video in the current folder." = "Spustí video do aktuální složky.";
"Stops the video and returns it once it is saved." = "Zastaví video a po uložení ho vrátí.";
"Takes a photo into the current folder and returns it." = "Vyfotí do aktuální složky a fotku vrátí.";
"The camera sends no picture. Check it in microCAM." = "Kamera neposílá obraz. Zkontroluj ji v microCAM.";
"microCAM is already recording." = "microCAM už nahrává.";
"microCAM is in viewer mode. Switch to camera mode in Settings → General." = "microCAM je v režimu prohlížeče. Přepni na režim kamery v Nastavení → Obecné.";
"microCAM is still saving the previous video. Try again in a moment." = "microCAM ještě ukládá předchozí video. Zkus to za chvíli.";
"microCAM isn't ready yet. Try again in a moment." = "microCAM ještě není připravený. Zkus to za chvíli.";
"microCAM isn't recording." = "microCAM nenahrává.";

