<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Source language is English; Resources/<lang>.lproj holds the translations (see README, Localization). -->
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key><array><string>en</string><string>cs</string></array>
    <key>CFBundleIdentifier</key><string>xyz.vaclavik.microcam</string>
    <key>CFBundleName</key><string>microCAM</string>
    <key>CFBundleDisplayName</key><string>microCAM</string>
    <key>CFBundleExecutable</key><string>MicroCAMApp</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIconName</key><string>AppIcon</string>
    <!-- Sparkle updates: the appcast is published with every GitHub release
         (scripts/release.sh). Without SUPublicEDKey the updater stays off. -->
    <key>SUFeedURL</key><string>https://github.com/vaclavik-xyz/microCAM/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key><string>kiDYGvLL1ztG0Mqn5Z+khTDelpzbq8oNqooPiOtAxUE=</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>NSHumanReadableCopyright</key><string>© 2026 Filip Václavík · MIT License</string>
    <key>CFBundleShortVersionString</key><string>0.2.0</string>
    <key>CFBundleVersion</key><string>4</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSCameraUsageDescription</key><string>microCAM shows and records the picture from your microscope camera.</string>
    <!-- Webhook over plain http only to local hosts/IPs (LAN, Tailscale IP); everything else needs https. -->
    <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <!-- macOS runs gesture detection (Vision/ANE) on every frame for "Reactions" unless the app opts out;
         that alone costs ~10 % CPU and a microscope never needs it. -->
    <key>NSCameraReactionEffectsEnabled</key><false/>
    <key>NSCameraReactionEffectGesturesEnabledDefault</key><false/>
    <!-- Live stream: Bonjour advertising for viewer mode and local-network privacy. -->
    <key>NSLocalNetworkUsageDescription</key><string>microCAM sends the live microscope picture to devices on your local network.</string>
    <key>NSBonjourServices</key><array><string>_microcam._tcp</string></array>
    <key>NSMicrophoneUsageDescription</key><string>microCAM records your narration with videos.</string>
</dict>
</plist>
